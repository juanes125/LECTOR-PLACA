    def _boton(self, padre, texto, color, comando):
        b = tk.Button(padre, text=texto, bg=color, fg="white",
                      font=("Segoe UI", 11, "bold"),
                      activebackground=color, activeforeground="white",
                      relief="flat", bd=0, cursor="hand2",
                      width=22, height=2, command=comando)
        b.pack(pady=5, fill="x")
        b.bind("<Enter>", lambda e, b=b, c=color: b.configure(bg=self._oscurecer(c)))
        b.bind("<Leave>", lambda e, b=b, c=color: b.configure(bg=c))
        return b

    @staticmethod
    def _oscurecer(hexcolor):
        hexcolor = hexcolor.lstrip("#")
        r, g, b = int(hexcolor[:2], 16), int(hexcolor[2:4], 16), int(hexcolor[4:], 16)
        r, g, b = max(0, r - 30), max(0, g - 30), max(0, b - 30)
        return f"#{r:02x}{g:02x}{b:02x}"

    # ===== Listas =====
    def refrescar_listas(self):
        self.lista_auth.delete(0, tk.END)
        self.lista_vet.delete(0, tk.END)
        for p in self.listas["autorizadas"]:
            self.lista_auth.insert(tk.END, f"  {p}")
        for p in self.listas["vetadas"]:
            self.lista_vet.insert(tk.END, f"  {p}")

    def pedir_placa(self, titulo):
        while True:
            texto = simpledialog.askstring(titulo, "Escribe la placa\n(carro: ABC123 / moto: ABC12D):",
                                            parent=self.raiz)
            if texto is None:
                return None
            texto = texto.strip().upper().replace(" ", "").replace("-", "")
            if PATRON_PLACA.match(texto):
                return texto
            messagebox.showerror("Formato inválido",
                                 "Formato incorrecto.\n\nCarro: 3 letras + 3 números (ABC123)\n"
                                 "Moto: 3 letras + 2 números + 1 letra (ABC12D)")

    def agregar_placa(self, destino):
        placa = self.pedir_placa(f"Agregar a {destino.upper()}")
        if not placa:
            return
        otra = "vetadas" if destino == "autorizadas" else "autorizadas"
        if placa in self.listas[otra]:
            self.listas[otra].remove(placa)
        if placa not in self.listas[destino]:
            self.listas[destino].append(placa)
            guardar_listas(self.listas)
            self.refrescar_listas()
            messagebox.showinfo("Guardado ✅", f"Placa {placa} agregada a {destino}.")
        else:
            messagebox.showinfo("Ya existe", f"{placa} ya estaba en {destino}.")

    def agregar_autorizada(self):
        self.agregar_placa("autorizadas")

    def agregar_vetada(self):
        self.agregar_placa("vetadas")

    def eliminar_placa(self):
        placa = self.pedir_placa("Eliminar placa")
        if not placa:
            return
        encontrada = False
        for lista in self.listas.values():
            if placa in lista:
                lista.remove(placa)
                encontrada = True
        if encontrada:
            guardar_listas(self.listas)
            self.refrescar_listas()
            messagebox.showinfo("Eliminada", f"Placa {placa} eliminada.")
        else:
            messagebox.showwarning("No existe", f"{placa} no estaba registrada.")

    # ===== Cámara en hilo =====
    def toggle_camara(self):
        if self.camara_activa:
            # Detener
            self.evento_detener.set()
            self.camara_activa = False
            self.btn_camara.config(text="🎥  Iniciar cámara", bg="#1a73e8")
        else:
            # Iniciar
            self.camara_activa = True
            self.evento_detener.clear()
            self.btn_camara.config(text="⏹️  Detener cámara", bg="#e53935")
            self.hilo_camara = threading.Thread(target=self._loop_camara, daemon=True)
            self.hilo_camara.start()

    def _loop_camara(self):
        """Loop de OpenCV que corre en un hilo separado para no bloquear la GUI."""
        cap = cv2.VideoCapture(INDICE_CAMARA, cv2.CAP_DSHOW) if os.name == "nt" else cv2.VideoCapture(INDICE_CAMARA)
        if not cap.isOpened():
            self.raiz.after(0, lambda: messagebox.showerror("Error", "No se pudo abrir la cámara."))
            self.camara_activa = False
            self.raiz.after(0, lambda: self.btn_camara.config(text="🎥  Iniciar cámara", bg="#1a73e8"))
            return

        cap.set(cv2.CAP_PROP_FRAME_WIDTH, ANCHO_CAMARA)
        cap.set(cv2.CAP_PROP_FRAME_HEIGHT, ALTO_CAMARA)

        hilo_ocr = LectorEnSegundoPlano(self.lector)
        cuadros = repeticiones = 0
        ultima = caja = letrero = None
        momento_caja = 0.0
        guardadas = {}

        while not self.evento_detener.is_set():
            ok, frame = cap.read()
            if not ok:
                break
            cuadros += 1

            # Recoger resultado del OCR
            resultado = hilo_ocr.recoger()
            if resultado:
                placa, caja_nueva, imagen, fue_completa = resultado
                if placa:
                    caja, momento_caja = caja_nueva, time.time()
                    repeticiones = repeticiones + 1 if placa == ultima else 1
                    ultima = placa
                    if (repeticiones >= LECTURAS_PARA_CONFIRMAR
                            and time.time() - guardadas.get(placa, 0) > SEGUNDOS_ENTRE_LECTURAS):
                        guardadas[placa] = time.time()
                        mensaje, color, archivo, estado = procesar_placa(placa, imagen, self.listas)
                        letrero = (mensaje, color, placa, archivo, time.time() + SEGUNDOS_LETRERO)

                        # Actualizar la GUI desde el hilo principal
                        self.raiz.after(0, lambda p=placa, e=estado: self._actualizar_ultima_lectura(p, e))
                elif fue_completa:
                    ultima, repeticiones, caja = None, 0, None

            if cuadros % OCR_CADA_N_FRAMES == 0:
                hilo_ocr.enviar(frame)

            # Dibujar
            if ultima and caja is not None and time.time() - momento_caja < 2.0:
                dibujar_caja(frame, caja, ultima)
            if letrero and time.time() < letrero[4]:
                dibujar_letrero(frame, *letrero[:4])

            cv2.imshow("Camara - presiona q para detener", frame)
            if cv2.waitKey(1) & 0xFF == ord("q"):
                break

        hilo_ocr.esperar()
        cap.release()
        cv2.destroyAllWindows()

        # Al terminar el loop, actualizar la GUI
        self.camara_activa = False
        self.raiz.after(0, lambda: self.btn_camara.config(text="🎥  Iniciar cámara", bg="#1a73e8"))

    # ===== Última lectura =====
    def _actualizar_ultima_lectura(self, placa, estado):
        self.ultima_placa_detectada = placa
        self.lbl_ultima_placa.config(text=placa)

        if estado == "AUTORIZADA":
            self.lbl_ultima_estado.config(text="✅ AUTORIZADA — puede ingresar", fg="#1b5e20")
            self._ocultar_botones_rapidos()
        elif estado == "VETADA":
            self.lbl_ultima_estado.config(text="🚫 VETADA — no debe ingresar", fg="#b71c1c")
            self._ocultar_botones_rapidos()
        else:  # NO REGISTRADA
            self.lbl_ultima_estado.config(text="⚠️ NO REGISTRADA — ¿qué quieres hacer?", fg="#e65100")
            self._mostrar_botones_rapidos()

    def _mostrar_botones_rapidos(self):
        self.btn_rapido_aut.pack(side="left", padx=(0, 6))
        self.btn_rapido_vet.pack(side="left", padx=(0, 6))
        self.btn_rapido_ign.pack(side="left")

    def _ocultar_botones_rapidos(self):
        self.btn_rapido_aut.pack_forget()
        self.btn_rapido_vet.pack_forget()
        self.btn_rapido_ign.pack_forget()

    def clasificar_ultima(self, destino):
        placa = self.ultima_placa_detectada
        if not placa:
            return
        otra = "vetadas" if destino == "autorizadas" else "autorizadas"
        if placa in self.listas[otra]:
            self.listas[otra].remove(placa)
        if placa not in self.listas[destino]:
            self.listas[destino].append(placa)
        guardar_listas(self.listas)
        self.refrescar_listas()
        messagebox.showinfo("Guardado ✅", f"Placa {placa} agregada a {destino}.")
        # Actualizar el estado en la sección de última lectura
        nuevo_estado = "AUTORIZADA" if destino == "autorizadas" else "VETADA"
        self._actualizar_ultima_lectura(placa, nuevo_estado)

    def ignorar_ultima(self):
        self.lbl_ultima_estado.config(text="🔕 Ignorada (queda como NO REGISTRADA)", fg="#888")
        self._ocultar_botones_rapidos()

    def salir(self):
        if self.camara_activa:
            self.evento_detener.set()
            time.sleep(0.3)
        if messagebox.askyesno("Salir", "¿Seguro que quieres salir?"):
            self.raiz.destroy()


# ===== PARTE 9: PROGRAMA PRINCIPAL =====
def main():
    crear_carpetas()
    listas = cargar_listas()
    print("Cargando lector OCR (la primera vez descarga modelos, espera)...")
    lector = easyocr.Reader(["en"], gpu=USAR_GPU)

    raiz = tk.Tk()
    app = AplicacionPlacas(raiz, listas, lector)
    raiz.mainloop()


if __name__ == "__main__":
